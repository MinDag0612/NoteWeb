# Frontend API endpoints for direct local development
REACT_APP_API_PROCESS_LOGIN=http://127.0.0.1:8000/login
REACT_APP_API_PROCESS_LOGIN_GG=http://127.0.0.1:8000/login-google
REACT_APP_API_NOTES=http://127.0.0.1:8000/get-notes
REACT_APP_API_ADD_NOTE=http://127.0.0.1:8000/create-note
REACT_APP_API_DELETE_NOTE=http://127.0.0.1:8000/delete-note
REACT_APP_API_UPDATE_NOTE=http://127.0.0.1:8000/notes/update
REACT_APP_API_IMAGE_UPLOAD=http://127.0.0.1:8000/upload-image
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend services
CLOUDY_NAME=your-cloudinary-cloud-name
CLOUDY_API_KEY=your-cloudinary-api-key
CLOUDY_SECRET=your-cloudinary-api-secret
MONGODB_URI=mongodb://127.0.0.1:27017/WebNote
JWT_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
