# Legacy compatibility service template.
# Use phase2/config/systemd/noteweb-backend.service for graded submission artifacts.

[Unit]
Description=NoteWeb FastAPI Backend (legacy reference)
After=network.target

[Service]
Type=simple
User=noteweb
Group=noteweb
WorkingDirectory=/var/www/NoteWeb
EnvironmentFile=/var/www/NoteWeb/.env
ExecStart=/var/www/NoteWeb/backendSrc/.venv/bin/gunicorn backendSrc.main:app --bind 127.0.0.1:8000 --workers 2 --worker-class uvicorn.workers.UvicornWorker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
