# Required by the API to sign JWTs. Generate a random secret before starting.
JWT_SECRET_KEY=

# Local development defaults. Docker Compose overrides the MongoDB address.
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional Google sign-in credentials.
GG_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_ID=

# Optional Cloudinary credentials (needed for image uploads).
CLOUDY_NAME=
CLOUDY_API_KEY=
CLOUDY_SECRET=

# Local React development server API URLs.
# Docker Compose uses the /api proxy configured in the frontend image.
REACT_APP_API_PROCESS_LOGIN=http://127.0.0.1:8000/login
REACT_APP_API_PROCESS_LOGIN_GG=http://127.0.0.1:8000/login-google
REACT_APP_API_NOTES=http://127.0.0.1:8000/get-notes
REACT_APP_API_ADD_NOTE=http://127.0.0.1:8000/create-note
REACT_APP_API_DELETE_NOTE=http://127.0.0.1:8000/delete-note
REACT_APP_API_UPDATE_NOTE=http://127.0.0.1:8000/notes/update
REACT_APP_API_IMAGE_UPLOAD=http://127.0.0.1:8000/upload-image
