[Unit]
Description=NoteWeb FastAPI Backend (Phase 2 host deployment)
After=network.target

[Service]
Type=simple
User=noteweb
Group=noteweb
WorkingDirectory=/var/www/NoteWeb
EnvironmentFile=/var/www/NoteWeb/.env
ExecStart=/var/www/NoteWeb/backendSrc/.venv/bin/gunicorn backendSrc.main:app --bind 127.0.0.1:8000 --workers 2 --worker-class uvicorn.workers.UvicornWorker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/NoteWeb/uploads /var/www/NoteWeb/logs

[Install]
WantedBy=multi-user.target
