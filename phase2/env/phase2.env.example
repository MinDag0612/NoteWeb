# Phase 2 host deployment environment template
# Copy to /var/www/NoteWeb/.env on Ubuntu host and replace all placeholders.

# Frontend API endpoints routed through the same domain
REACT_APP_API_PROCESS_LOGIN=/api/login
REACT_APP_API_PROCESS_LOGIN_GG=/api/login-google
REACT_APP_API_NOTES=/api/get-notes
REACT_APP_API_ADD_NOTE=/api/create-note
REACT_APP_API_DELETE_NOTE=/api/delete-note
REACT_APP_API_UPDATE_NOTE=/api/notes/update
REACT_APP_API_IMAGE_UPLOAD=/api/upload-image
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend runtime
MONGODB_URI=mongodb://127.0.0.1:27017/WebNote
JWT_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
BACKEND_CORS_ORIGINS=https://your-domain.example,https://www.your-domain.example
API_ROOT_PATH=/api

# Upload behavior
UPLOAD_STORAGE_MODE=hybrid
UPLOAD_LOCAL_DIR=/var/www/NoteWeb/uploads
PUBLIC_BASE_URL=https://your-domain.example
UPLOAD_CLOUDINARY_FOLDER=NoteWeb

# Optional Cloudinary fallback
CLOUDY_NAME=your-cloudinary-cloud-name
CLOUDY_API_KEY=your-cloudinary-api-key
CLOUDY_SECRET=your-cloudinary-api-secret
