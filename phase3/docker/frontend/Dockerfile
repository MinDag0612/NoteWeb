FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY public ./public
COPY src ./src

ARG REACT_APP_API_PROCESS_LOGIN=/api/login
ARG REACT_APP_API_PROCESS_LOGIN_GG=/api/login-google
ARG REACT_APP_API_NOTES=/api/get-notes
ARG REACT_APP_API_ADD_NOTE=/api/create-note
ARG REACT_APP_API_DELETE_NOTE=/api/delete-note
ARG REACT_APP_API_UPDATE_NOTE=/api/notes/update
ARG REACT_APP_API_IMAGE_UPLOAD=/api/upload-image
ARG REACT_APP_GOOGLE_CLIENT_ID=

ENV REACT_APP_API_PROCESS_LOGIN=${REACT_APP_API_PROCESS_LOGIN}
ENV REACT_APP_API_PROCESS_LOGIN_GG=${REACT_APP_API_PROCESS_LOGIN_GG}
ENV REACT_APP_API_NOTES=${REACT_APP_API_NOTES}
ENV REACT_APP_API_ADD_NOTE=${REACT_APP_API_ADD_NOTE}
ENV REACT_APP_API_DELETE_NOTE=${REACT_APP_API_DELETE_NOTE}
ENV REACT_APP_API_UPDATE_NOTE=${REACT_APP_API_UPDATE_NOTE}
ENV REACT_APP_API_IMAGE_UPLOAD=${REACT_APP_API_IMAGE_UPLOAD}
ENV REACT_APP_GOOGLE_CLIENT_ID=${REACT_APP_GOOGLE_CLIENT_ID}

RUN npm run build

FROM nginx:1.27-alpine

COPY phase3/docker/frontend/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
